# PolyGen Week 1 Environment Configuration
POLYGEN_HOST=0.0.0.0
POLYGEN_PORT=8001

# Engine selection:
# - auto: Uses TripoSR / Shap-E on CUDA GPU if available, otherwise fast procedural Trimesh OBJ synthesis
# - triposr: Forces TripoSR neural mesh reconstruction
# - shap_e: Forces OpenAI Shap-E text-to-3D diffusion
# - procedural: Uses prompt-guided procedural OBJ synthesis (fast CPU mode)
POLYGEN_ENGINE=auto
POLYGEN_DEVICE=auto
POLYGEN_OUTPUT_DIR=outputs

